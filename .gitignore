.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Build / tooling
build/
dist/
*.egg-info/
.python-version.bak

# Experiment outputs
checkpoints/
**/checkpoints*/
wandb/
logs/
plot_data/
*.pt
*.npy
